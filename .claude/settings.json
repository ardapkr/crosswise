{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm *)", "Bash(npx *)", "Bash(node *)", "Bash(git *)", "Bash(gh *)",
      "Bash(vercel *)", "Bash(curl *)", "Bash(ffmpeg *)", "Bash(ffprobe *)",
      "Bash(python3 *)", "Bash(python *)", "Bash(jq *)",
      "Bash(cd *)", "Bash(ls *)", "Bash(pwd)", "Bash(cat *)", "Bash(head *)", "Bash(tail *)",
      "Bash(grep *)", "Bash(find *)", "Bash(wc *)", "Bash(sort *)", "Bash(sed *)", "Bash(awk *)",
      "Bash(echo *)", "Bash(printf *)", "Bash(which *)", "Bash(test *)", "Bash(date *)",
      "Bash(mkdir *)", "Bash(cp *)", "Bash(mv *)", "Bash(rm *)", "Bash(touch *)",
      "Bash(zip *)", "Bash(unzip *)", "Bash(tar *)",
      "Bash(sleep *)", "Bash(lsof *)", "Bash(kill *)", "Bash(pkill *)", "Bash(ps *)",
      "WebFetch", "WebSearch"
