{
  "name": "crosswise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Accessible pedestrian navigation for Vienna: safest crossings, live bus scan, spoken guidance.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
